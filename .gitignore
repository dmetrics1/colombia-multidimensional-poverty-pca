# ==========================================
# Gitignore - Workspace Raíz del Proyecto IPM
# ==========================================

# Ignorar la carpeta de datos masivos DANE en la raíz (contiene archivos .dta y .sav pesados)
/datos/

# Ignorar configuraciones del entorno local y habilidades personalizadas
/.vscode/
/skill.sh/

# Ignorar archivos del sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ==========================================
# Reglas para proyecto_ipm (Exclusión de datos pesados y salidas binarias gigantes)
# ==========================================
/proyecto_ipm/datos/raw/*.csv
/proyecto_ipm/datos/procesados/*.rds
/proyecto_ipm/informe_ipm_portafolio.html
/proyecto_ipm/articulo_pobreza_multidimensional.docx
.Rproj.user
